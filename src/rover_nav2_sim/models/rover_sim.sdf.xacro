<?xml version="1.0"?>
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.865"/>
  <xacro:property name="base_width" value="0.645"/>
  <xacro:property name="base_height" value="0.24"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_length" value="0.05"/>
  <xacro:property name="wheel_y" value="${(base_width + wheel_length) / 2.0}"/>
  <xacro:property name="skid_steer_track_width" value="${base_width + wheel_length}"/>
  <xacro:property name="skid_steer_lateral_friction" value="0.35"/>
  <xacro:property name="front_x" value="${base_length / 3.0}"/>
  <xacro:property name="middle_x" value="0.0"/>
  <xacro:property name="back_x" value="${-base_length / 3.0}"/>
  <xacro:property name="lidar_x" value="${base_length / 2.0 - 0.23}"/>
  <xacro:property name="lidar_z" value="${base_height + 0.10}"/>
  <xacro:property name="zed_x" value="${base_length / 2.0 - 0.23}"/>
  <xacro:property name="zed_z" value="${base_height + 0.30}"/>

  <xacro:macro name="wheel_link_and_joint" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <pose relative_to="base_link">${x} ${y} 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.004</ixx>
          <iyy>0.004</iyy>
          <izz>0.004</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>${wheel_radius}</radius>
            <length>${wheel_length}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>${wheel_radius}</radius>
            <length>${wheel_length}</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>${skid_steer_lateral_friction}</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="base_${prefix}_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>${prefix}_wheel_link</child>
      <pose relative_to="base_link">${x} ${y} 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>
  </xacro:macro>

  <model name="rover">
    <static>false</static>
    <self_collide>false</self_collide>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_footprint">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="base_link">
      <pose relative_to="base_footprint">0 0 ${wheel_radius} 0 0 0</pose>
      <inertial>
        <mass>35.0</mass>
        <inertia>
          <ixx>1.7</ixx>
          <iyy>3.0</iyy>
          <izz>3.7</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <pose>0 0 ${base_height / 2.0} 0 0 0</pose>
        <geometry>
          <box>
            <size>${base_length} ${base_width} ${base_height}</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.32 0.70 1</ambient>
          <diffuse>0.18 0.32 0.70 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 ${base_height / 2.0} 0 0 0</pose>
        <geometry>
          <box>
            <size>${base_length} ${base_width} ${base_height}</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <xacro:wheel_link_and_joint prefix="front_left" x="${front_x}" y="${wheel_y}"/>
    <xacro:wheel_link_and_joint prefix="middle_left" x="${middle_x}" y="${wheel_y}"/>
    <xacro:wheel_link_and_joint prefix="back_left" x="${back_x}" y="${wheel_y}"/>
    <xacro:wheel_link_and_joint prefix="front_right" x="${front_x}" y="${-wheel_y}"/>
    <xacro:wheel_link_and_joint prefix="middle_right" x="${middle_x}" y="${-wheel_y}"/>
    <xacro:wheel_link_and_joint prefix="back_right" x="${back_x}" y="${-wheel_y}"/>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose relative_to="base_link">${lidar_x} 0 ${lidar_z} 0 0 0</pose>
    </joint>
    <link name="lidar_link">
      <pose relative_to="base_link">${lidar_x} 0 ${lidar_z} 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.060</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.05 0.05 0.06 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.060</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <joint name="zed_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>zed_camera_link</child>
      <pose relative_to="base_link">${zed_x} 0 ${zed_z} 0 0 0</pose>
    </joint>
    <link name="zed_camera_link">
      <pose relative_to="base_link">${zed_x} 0 ${zed_z} 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.08 0.18 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.025 1</ambient>
          <diffuse>0.02 0.02 0.025 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.08 0.18 0.05</size>
          </box>
        </geometry>
      </collision>
      <sensor name="zed_depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10.0</update_rate>
        <topic>/zed/depth</topic>
        <gz_frame_id>zed_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
          </image>
          <clip>
            <near>0.20</near>
            <far>5.0</far>
          </clip>
        </camera>
        <baseline>0.12</baseline>
        <pointCloudCutoff>0.35</pointCloudCutoff>
        <pointCloudCutoffMax>5.0</pointCloudCutoffMax>
        <distortionK1>0</distortionK1>
        <distortionK2>0</distortionK2>
        <distortionK3>0</distortionK3>
        <distortionT1>0</distortionT1>
        <distortionT2>0</distortionT2>
        <CxPrime>0</CxPrime>
        <Cx>0</Cx>
        <Cy>0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
      </sensor>
    </link>

    <!--
      Skid-steer drive model.

      Gazebo Sim uses the DiffDrive system for left/right side velocity control.
      Because this model passes three left wheel joints and three right wheel
      joints, each side is driven as a locked wheel group, which is the
      skid-steer behavior we want for this rover.
    -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>base_front_left_wheel_joint</left_joint>
      <left_joint>base_middle_left_wheel_joint</left_joint>
      <left_joint>base_back_left_wheel_joint</left_joint>
      <right_joint>base_front_right_wheel_joint</right_joint>
      <right_joint>base_middle_right_wheel_joint</right_joint>
      <right_joint>base_back_right_wheel_joint</right_joint>
      <wheel_separation>${skid_steer_track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.2</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
      <min_angular_velocity>-1.2</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </model>
</sdf>
